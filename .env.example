# Leave empty to use local content samples and browser persistence.
# Set to /api/backend (same-origin proxy) or your own API origin to enable server-backed repositories.
VITE_API_BASE_URL=

# Server-only HTTPS root for the operator-owned LibTV backend. Never prefix with VITE_.
LIBTV_BACKEND_URL=

# Server-only. Connect a public Vercel Blob store; never prefix these with VITE_.
BLOB_READ_WRITE_TOKEN=
# Configure a strong private management password and an independent random secret (32+ chars).
FILM_PUBLISH_PASSWORD=
FILM_PUBLISH_SECRET=

# Server-only origin for the Xumeng/DZMM API. Keep this out of VITE_* values.
XUMENG_BACKEND_URL=
# Set to dzmm when the upstream is IntVideoGameEditor's /api/dzmm and /api/backend/v1 API.
XUMENG_BACKEND_PROTOCOL=generic
