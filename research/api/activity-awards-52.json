agIcon":"","children":null,"tagType":5},{"id":3043,"code":"test","tagLabel":"3-非遗创生","parentTag":3040,"categoryId":0,"path":"3040/3043","tagStatus":1,"tagOrder":10,"tagIcon":"","children":null,"tagType":5},{"id":1501,"code":"humanity_science","tagLabel":"人文科普","parentTag":1500,"categoryId":0,"path":"1500/1501/","tagStatus":1,"tagOrder":1,"tagIcon":"","children":null,"tagType":1},{"id":1000,"code":"selected","tagLabel":"精选画布","parentTag":0,"categoryId":0,"path":"1000/","tagStatus":1,"tagOrder":1,"tagIcon":"","children":null,"tagType":1},{"id":1205,"code":"culture_tourism","tagLabel":"文旅政媒","parentTag":1200,"categoryId":0,"path":"1200/1205/","tagStatus":1,"tagOrder":5,"tagIcon":"","children":null,"tagType":1}],"isTop":false,"score":60,"auditBy":179,"socialMediaUrl":"https://v.douyin.com/p6TYCURqH_w/","createAt":"2026年06月30日 14:22","updateAt":"2026年07月03日 14:45","publishAt":"2026年06月30日 14:22","awardedTag":["非遗创生-最佳文化表达"]},{"templateUuid":"fd1f4aac688845079962f27a791b5b9a","projectUuid":"e22025d32dc042dfa9876951e2c39d43","name":"【一纸起英歌】｜原创非遗剪纸画芯","description":"《一纸起英歌》以“一张剪纸的创生”为叙事核心，将潮阳文脉中的祠堂建筑、英歌舞、端午守护、龙舟水纹、潮汕云纹等文化符号，转译为可收藏、可替换、可赠礼的非遗文创产品。\n\n影片不以真人表演复现非遗，而是建立一个完全由纸构成的风格化世界：纸张醒来，折出潮阳纸城；剪出英歌面谱；立起英歌纸人；让纸人列阵起舞；再将舞蹈能量幻化为端午守护纹。最终，所有纸艺元素回折、重组，成为「纸潮 ZHICHAO」剪纸画芯系列与发光纸影框。\n\n视觉上，影片以深灰暗场、白灰折纸舞台、漆红镂空剪纸、暖金背光为核心语言。产品外框采用潮州金漆木雕风格，融入祠堂木雕、卷草纹、云纹、花鸟纹等浮雕元素，让潮阳文化从民俗现场进入现代生活空间。\n\n“纸潮 ZHICHAO”不是单一英歌衍生品，而是以纸艺为媒介，将潮阳文化转化为现代生活中的光影文创。它让非遗不只被观看，也能被带回家、被点亮、被收藏。","coverUrl":"https://liblibai-online.liblib.cloud/img/bc19270a4e744fa38a01a9ebbdab3244/6cf1a09018e7d040c2c58e59d8ff2cf51489c622a3adf982ae86d5096cd3061a.jpg","finalOutput":"https://libtv-res.liblib.art/upload-images/bc19270a4e744fa38a01a9ebbdab3244/746441bc1e21240fbb711ae9993ae8974b56c40c.mp4","snapshotId":21187,"auditStatus":1,"ownerId":7691513,"ownerUuid":"bc19270a4e744fa38a01a9ebbdab3244","avatar":"https://liblibai-online.liblib.cloud/img/bc19270a4e744fa38a01a9ebbdab3244/722e023f39d7dc69916f25658bdde4e848938d9d58c50b42700341045d12e5