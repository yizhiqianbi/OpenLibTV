{"code": 0, "data": {"list": [{"templateUuid": "7d84100da6844848a0c2a2711e722da7", "projectUuid": "f1168bba07854a40962555a7499b34a1", "name": "峡谷开麦·亮懿对决", "description": "当王者峡谷变成嘻哈舞台，诸葛亮与司马懿会如何一决高下？\n\n《峡谷开麦·亮懿对决》以两位英雄的智谋交锋为灵感，将峡谷战术、技能梗与人物性格融入原创说唱。从技能登场到轮番对唱，两人用押韵互相拆招，也用肢体律动点燃现场。台下英雄、小兵、暴君与主宰共同围观，让熟悉的峡谷角色成为这场演出的参与者。\n\n作品通过AI影像重塑人物与场景，以写实造型、蓝紫灯光、运动镜头和观众互动，呈现一场属于王者峡谷的嘻哈对决。", "coverUrl": "https://libtv-res.liblib.art/upload-images/c873de0863e04bb3b1706b47ef1acd41/0e7fb10dcbe7c9bcd060c57c3ddef503ee90ad01.jpg", "finalOutput": "https://libtv-res.liblib.art/upload-images/c873de0863e04bb3b1706b47ef1acd41/61021a2d6c357725d357dcb7ee30ff73a6bbb152.mp4", "snapshotId": 56950, "auditStatus": 1, "ownerId": 8612706, "ownerUuid": "c873de0863e04bb3b1706b47ef1acd41", "avatar": "https://liblibai-online.liblib.cloud/web/avatar/avatar1.png", "nickname": "150****6176", "isLike": false, "likeCount": 1, "tags": [{"id": 3063, "code": "test", "tagLabel": "王者无界剧场计划", "parentTag": 0, "categoryId": 0, "path": "3063/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1203, "code": "variety_show", "tagLabel": "综艺晚会", "parentTag": 1200, "categoryId": 0, "path": "1200/1203/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1304, "code": "classic_derivative", "tagLabel": "经典衍生", "parentTag": 1300, "categoryId": 0, "path": "1300/1304/", "tagStatus": 1, "tagOrder": 4, "tagIcon": "", "children": null, "tagType": 1}], "isTop": false, "score": 60, "auditBy": 286, "socialMediaUrl": "https://v.douyin.com/fXKxBejoHEA/ hBT:/ k@C.uS :0pm 03/15", "createAt": "2026年10月06日 20:28", "updateAt": "2026年10月06日 21:10", "publishAt": "2026年10月06日 20:28", "recommendOtherRes": {"utLogMap": {"author_id": "8612706", "hot_factor": "1.1112605001534575", "is_new": "false", "quality_score": "1.0", "sr_bucket_id": "none", "sr_final_score": "1.1113", "sr_match_score": "0.0000", "sr_match_type": "1", "sr_rel_score": "-1.0000", "sr_scene_id": "20000"}}}, {"