倔强地不肯退让，最终却被小鸭子 “我们有两个妈妈啦” 的天真话语融化，也收获了鸭妈妈的善意与感谢。", "coverUrl": "https://liblibai-online.liblib.cloud/img/7588e943592348ae8a829b33e4f264bd/0cc09eabb2bf910f3b74301d44d12fdb205748bc5f4dddd87198232659003ca6.png", "finalOutput": "https://libtv-res.liblib.art/upload-images/7588e943592348ae8a829b33e4f264bd/c3aae9a105786088093126c73f34708b4c903c78.mp4", "snapshotId": 1639, "auditStatus": 1, "ownerId": 2550435, "ownerUuid": "7588e943592348ae8a829b33e4f264bd", "avatar": "https://liblibai-online.liblib.cloud/img/7588e943592348ae8a829b33e4f264bd/43724ebb1253656b8b8b1dc260d39459795309b56bece394d3f01919ae3afdad.jpg", "nickname": "CheerGo", "isLike": false, "likeCount": 135, "tags": [{"id": 1303, "code": "short_animation", "tagLabel": "动画短片", "parentTag": 1300, "categoryId": 0, "path": "1300/1303/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "https://liblibai-online.liblib.cloud/web/976652348270470eba25b9d8ca891fda/4791dc8d-8724-4174-aa5c-f802e50ac9d6.png", "primaryIcon": "https://liblibai-online.liblib.cloud/web/8244a30ac2e94d9289e7216922b50a09/24e4dd04-49c7-47b1-b932-21971474d9c5.png", "desc": "LibTV先锋作者", "verifyLevel": 1}], "isTop": false, "score": 60, "auditBy": 178, "socialMediaUrl": "关于我用AI做了一段动画短片!!! 这是一段手绘水彩风格... http://xhslink.com/o/AymIorR2Q3j  复制后打开【小红书】查看笔记！", "createAt": "2026年03月25日 19:19", "updateAt": "2026年04月17日 01:32", "publishAt": "2026年03月27日 01:09", "recommendOtherRes": {"utLogMap": {"author_id": "2550435", "hot_factor": "1.0", "is_new": "false", "quality_score": "2.0", "sr_bucket_id": "none", "sr_final_score": "2.0000", "sr_match_score": "0.0000", "sr_match_type": "1", "sr_rel_score": "-1.0000", "sr_scene_id": "20000"}}}, {"templateUuid": "a8edbd9ab56e467e98fbb1a7f854e374", "projectUuid": "3113f04b234143638b2f15a1f7817edd", "name": "苍穹破晓", "description": "start video 2.0", "coverUrl": "https://libtv-res.liblib.art/upload-images/97910539ca4d47c0bf1356793347cad4/df715a2847