，也是做个作品警戒自己不要沉迷创作而一叶障目，需要集大家之所长，丰富的输出精品", "coverUrl": "https://libtv-res.liblib.art/upload-images/bccf040dc9f54ca8b4b93d4d7375af0e/1dcb0a2353a7870c7b0624df9c7c071a052bd5b5.jpg", "finalOutput": "https://libtv-res.liblib.art/upload-images/bccf040dc9f54ca8b4b93d4d7375af0e/f1b91be8abbbba60a41cfa96fa646e4d22af0522.MOV", "snapshotId": 5195, "auditStatus": 1, "ownerId": 191459, "ownerUuid": "bccf040dc9f54ca8b4b93d4d7375af0e", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/DYAIOgq83eoGlWFclsfeAepznlDFias1YTJNutibicIDc3kyrzbSHJ71ALnic4J0NXsHId7agEwqfH1icz7JgmYpGhg/132", "nickname": "大王先声", "isLike": false, "likeCount": 1, "tags": [{"id": 3021, "code": "test", "tagLabel": "AI影像狂飙季", "parentTag": 0, "categoryId": 0, "path": "3021/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3023, "code": "test", "tagLabel": "创意单元", "parentTag": 3021, "categoryId": 0, "path": "3021/3023", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1507, "code": "other", "tagLabel": "其他", "parentTag": 1500, "categoryId": 0, "path": "1500/1507/", "tagStatus": 1, "tagOrder": 7, "tagIcon": "", "children": null, "tagType": 1}], "isTop": false, "score": 60, "auditBy": 176, "socialMediaUrl": "https://www.xiaohongshu.com/explore/69df1562000000002101222c?xsec_token=ABmWR9vA6a5RoSZ5ou2UXQnYhLebRuKzxiYbXbNgdq_yE=&xsec_source=pc_user", "createAt": "2026年04月15日 12:37", "updateAt": "2026年04月22日 23:49", "publishAt": "2026年04月15日 12:37", "recommendOtherRes": {"utLogMap": {"author_id": "191459", "hot_factor": "1.0", "is_new": "false", "quality_score": "1.0", "sr_bucket_id": "none", "sr_final_score": "1.0000", "sr_match_score": "0.0000", "sr_match_type": "1", "sr_rel_score": "-1.0000", "sr_scene_id": "20000"}}}, {"templateUuid": "4395637be7df44dd9a42025b6e42d9fb", "projectUuid": "c4a26aec74cc4645bd92f82671edb04b", "name": "渔歌子", "description": "孩子背古诗没有画面，我给她用libTV做了一个，效果很好，背起来也很快", "coverUrl": "https://libtv-res.liblib.art/upload-images/49