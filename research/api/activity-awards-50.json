Like":false,"likeCount":87,"tags":[{"id":3035,"code":"prod","tagLabel":"大乱斗｜vol.2《AI，想象和尖叫》","parentTag":0,"categoryId":0,"path":"3035/","tagStatus":1,"tagOrder":10,"tagIcon":"","children":null,"tagType":5},{"id":1303,"code":"short_animation","tagLabel":"动画短片","parentTag":1300,"categoryId":0,"path":"1300/1303/","tagStatus":1,"tagOrder":3,"tagIcon":"","children":null,"tagType":1}],"isTop":false,"score":60,"auditBy":179,"socialMediaUrl":"https://www.douyin.com/user/self?from_tab_name=main\u0026modal_id=7646373337609866548\u0026showSubTab=video\u0026showTab=post","createAt":"2026年06月01日 18:59","updateAt":"2026年06月08日 20:26","publishAt":"2026年06月01日 18:59","awardedTag":["最佳剧情"]},{"templateUuid":"d87e50ae2b5e4930a4d861d987e66617","projectUuid":"7af8f60bd0534412b92a92c5455c7781","name":"《极夜低语》（Whispers of the Polar Night）","description":"南极万年冰川下，科考队唤醒了沉睡的异星菌丝。在这股庞大的宇宙意识里，人类不是要消灭的敌人，而是一群因灵魂无法相通、正遭受“孤独”这种精神绝症折磨的可怜病人。为了治愈他们，它放出温和的荧光菌丝，开始精密重塑人类的神经。\n然而对未知的恐惧引发了疯狂，人类在猜忌中用烈火自相残杀，拼死抗拒它的“拯救”。防线崩溃后，被同化的“医生”在火光中走向绝望的幸存者，整条手臂爆裂成发光的触手巨网。在荧光融入脸庞、恐惧消融化作安详微笑的瞬间，他终于不再孤独。\n大火寂灭，一只带着荧质菌丝的小狗走向无垠风雪。它回头，裂开的头颅里喷出黏稠而具有智慧的菌丝，直扑你的屏幕。它说，我们痊愈了。但这究竟是进化的恩赐，还是文明的寂灭？","coverUrl":"https://libtv-res.liblib.art/upload-images/d20421bb9cac40fb99763d309111430a/f12444946fd5d4572c54adec400749b6b1690267.png","finalOutput":"https://libtv-res.liblib.art/upload-images/d20421bb9cac40fb99763d309111430a/2d30dfb743621464b9b824e337bc8a904eb223e5.mp4","snapshotId":15607,"auditStatus":1,"ownerId":3462983,"ownerUuid":"d20421bb9cac40fb99763d309111430a","avatar":"https://liblibai-online.liblib.cloud/img/d20421bb9cac40fb99763d309111430a/0564918b6d701c6471493c00c76d8cca97ab448fd9ee92b5962e510338053e5b.png","nickname":"大大大大大","isLike":false,"likeCount":8,"tags":[{"id":3035,"code":"prod","tagLabel":"大乱斗｜vol.2《AI，想象和尖叫》","parentTag":0,"categoryId":0,"path":"3035/","tagStatus":1,"tagOrder":10,"tagIcon":"","children":null,"tagType":5},{"id":1201,"code":"short_series","tagLabel":"短片剧集","parentTag":1200,"categoryId":0,"path":"1200/1