gIcon":"","children":null,"tagType":5},{"id":1304,"code":"classic_derivative","tagLabel":"经典衍生","parentTag":1300,"categoryId":0,"path":"1300/1304/","tagStatus":1,"tagOrder":4,"tagIcon":"","children":null,"tagType":1},{"id":1201,"code":"short_series","tagLabel":"短片剧集","parentTag":1200,"categoryId":0,"path":"1200/1201/","tagStatus":1,"tagOrder":1,"tagIcon":"","children":null,"tagType":1},{"id":1000,"code":"selected","tagLabel":"精选画布","parentTag":0,"categoryId":0,"path":"1000/","tagStatus":1,"tagOrder":1,"tagIcon":"","children":null,"tagType":1}],"isTop":false,"score":60,"auditBy":266,"socialMediaUrl":"https://v.douyin.com/byVCXh9V_7Y/","createAt":"2026年08月23日 10:20","updateAt":"2026年08月26日 16:27","publishAt":"2026年08月23日 10:20","awardedTag":["入围奖"]},{"templateUuid":"c8f8bd5d6c154b868917c052c5ce3051","projectUuid":"7e6c7c80347b4a8dbdc55359b0b80e20","name":"《 牛来 | 云下三千》牛来二创","description":"梦即未来\n牛来梦中以成年形态经历的巨蛇、羽刃、影狼、风弓、心魔暗牛，都是尚未发生的现实。云雀预知自己未来会与牛来并肩，于是提前在他心里播种。他没有改变未来，只是让牛来在明天到来之前，先以成年的自己活过一遍。\n\n你不需要记得那场梦。你只需要在该迈步的时候，腿自己动。\n云雀没有给牛来勇气。勇气是清醒的选择，是英雄的品质 —— 牛来不是英雄，他只是一头会怕的小牛。云雀给他的是更底层的东西：身体的记忆。在梦里他已经怕过一次、冲过一次、站住过一次，所以当未来真正到来，他的骨头会比脑子先反应过来。\n他不记得云雀长什么样，不记得风弓的重量。但他的身体记得。\n梦醒后他举着空手比划，笑得天真灿烂。他不知道自己比划的一切都是真的。\n而云雀站在树顶看着他，金色眼睛平静温暖。\n种子埋下的时候，种子自己不知道。","coverUrl":"https://libtv-res.liblib.art/upload-images/bc19270a4e744fa38a01a9ebbdab3244/f9aae6ec4c4687cbd566e969e76353212188bf86.png","finalOutput":"https://libtv-res.liblib.art/upload-images/bc19270a4e744fa38a01a9ebbdab3244/8ce6c90f76ddde7b1cd3be881edbf8e524a66b29.mp4","snapshotId":40044,"auditStatus":1,"ownerId":7691513,"ownerUuid":"bc19270a4e744fa38a01a9ebbdab3244","avatar":"https://liblibai-online.liblib.cloud/img/bc19270a4e744fa38a01a9ebbdab3244/722e023f39d7dc69916f25658bdde4e848938d9d58c50b42700341045d12e52f.jpg","nickname":"追逐星辰","isLike":false,"likeCount":9,"tags":[{"id":3054,"code":"test","tagLabel":"AI重制那头牛大赛","parentTag":0,"categoryId":0,"path":"3054/","tagStatus":1,"tagOrder":10,"tagIcon":"","children":null,"tagType":5},{"