{
  "name": "libtv-recreation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run film:build && vite --host 0.0.0.0",
    "build": "npm run film:build && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "vercel:prepare": "npm run film:build && vercel build --prod --yes && node scripts/prepare-vercel-output.mjs",
    "lint": "eslint src api scripts/*.mjs *.config.js --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src api scripts/*.mjs *.config.js *.json *.md .github/workflows/*.yml",
    "format:check": "prettier --check src api scripts/*.mjs *.config.js *.json *.md .github/workflows/*.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "assets:audit": "node scripts/archive-unused-assets.mjs",
    "assets:archive": "node scripts/archive-unused-assets.mjs --apply",
    "film:build": "node scripts/build-film-player.mjs",
    "dev:server": "npm run film:build && vercel dev",
    "vercel:prepare:preview": "npm run film:build && vercel build --yes && node scripts/prepare-vercel-output.mjs",
    "tool:mcp": "node scripts/penstudio-mcp-server.mjs",
    "test:mcp": "node --test scripts/penstudio-mcp.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@vercel/blob": "2.8.1",
    "fflate": "0.8.3",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.468.0",
    "marked": "17.0.6",
    "media-chrome": "^4.19.3",
    "react": "^19.1.0",
    "react-colorful": "5.8.1",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
