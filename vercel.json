{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|data/|api/|film-runtime/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/film/complete.ts": {
      "includeFiles": "dist-film/player.iife.js",
      "maxDuration": 60
    },
    "api/film/start.ts": {
      "includeFiles": "dist-film/player.iife.js",
      "maxDuration": 60
    },
    "api/film/upload.ts": {
      "maxDuration": 60
    },
    "api/film/release.ts": {
      "maxDuration": 30
    },
    "api/backend/[...path].ts": {
      "maxDuration": 180
    },
    "api/xumeng/[...path].ts": {
      "maxDuration": 120
    }
  }
}
