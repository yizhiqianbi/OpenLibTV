{"detail": {"templateUuid": "07534d3a9bc54b6a9080de2720c13d8a", "projectUuid": "7e5b076eb9374601b60c0b3834e7af87", "name": "BLUE NIGHT蓝色奇妙夜", "description": "当爵士乐器们被唤醒，蓝色的夜晚也开始摇摆了\n这一次，由乐器引导着乐手穿过漂浮、错位、下坠，展开一场关于爵士历史的漫游。Jazz 不再只被听见，也化作不断变化的视觉节奏，被看见、被感受到。人物、乐器、海报、空间与舞台彼此牵引，最后汇入同一场演出——灯光亮起，幕布拉开，LET’S SWING!\n\n这次创作集中测试了 MiniMax H3 在 MG 动画表达上的丰富度：不规则拼格漫画的动态合成、人物破框、遮挡转场、空间连续变形、幕布开合，以及跟随爵士乐重音与鼓点完成动作和镜头卡点。前期也结合 GPT 对音频节奏的分析，将音乐中的重拍、段落变化与动作密度提前拆解，再转化成更具体的视频生成指令。整个过程几乎没有依赖复杂后期，许多原本需要在剪辑、合成软件中完成的动态关系，直接在生成阶段实现。\n节奏推着画面往前，画面又跟着音乐继续生长。整个创作过程，酣畅淋漓。", "coverUrl": "/assets/bd0ead1552cd2740.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/4e08bd47793e4c2694be236e4d5baeb7/3221611a9af39ed7e20f11df18fbc54fab0d9711.mp4", "snapshotId": 46596, "auditStatus": 1, "ownerId": 1461743, "ownerUuid": "4e08bd47793e4c2694be236e4d5baeb7", "avatar": "/assets/3dfd514db66797b5.webp", "nickname": "tattva", "isLike": false, "likeCount": 34, "tags": [{"id": 3057, "code": "test", "tagLabel": "一场戏的诞生 ", "parentTag": 0, "categoryId": 0, "path": "3057/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3060, "code": "test", "tagLabel": "3. 盗梦空间", "parentTag": 3057, "categoryId": 0, "path": "3057/3060", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1305, "code": "concept_design", "tagLabel": "概念设计", "parentTag": 1300, "categoryId": 0, "path": "1300/1305/", "tagStatus": 1, "tagOrder": 5, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5002, "name": "专业", "icon": "/assets/a31a6cc391430f72.webp", "primaryIcon": "/assets/7097b07d2df12cc8.webp", "desc": "LibTV专业作者", "verifyLevel": 2}], "score": 0, "socialMediaUrl": "https://www.xiaohongshu.com/explore/6aa9193400000000280291a0?xsec_token=CBipxL-AnUmzeoO7_PxgsN3-hhRyAoQUFb8cgBQ6qWCr8", "createAt": "2026年09月15日 18:13", "updateAt": "2026年09月22日 20:16", "publishAt": "2026年09月15日 18:13", "playCount": 66, "viewCreationProcessCount": 20, "copyCanvasCount