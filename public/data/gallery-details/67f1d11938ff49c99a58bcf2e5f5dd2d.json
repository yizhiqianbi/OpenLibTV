{"detail": {"templateUuid": "67f1d11938ff49c99a58bcf2e5f5dd2d", "projectUuid": "a8d6f63913954a89a26c5a587b7a00e3", "name": "命运之引", "description": "被困在时间孤岛千年的海诺，在残缺的记忆里背负无尽遗憾。\n解封记忆的他，借琉璃海螺逆转时光，重回浩劫降临的前夜，\n想要改写人鱼少女朵莉亚献祭苍生的宿命。\n他亲手斩断阴谋、对抗宿命，却发现命运早已既定。\n为留住世间与挚爱，海诺燃尽千年时光修为，跨时空赠予年少\n的自己逆转乾坤的力量，成功平息海域浩劫。\n最终岁月回响、晚风回音，跨越千年的意难平，在最后一刻，\n终等来温柔重逢。", "coverUrl": "/assets/98278f814c87bed4.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/b581817138884f67ba49f4956d412404/2d82e861586e20e7c3df64622494a8075d3a463c.mp4", "snapshotId": 56465, "auditStatus": 1, "ownerId": 6984613, "ownerUuid": "b581817138884f67ba49f4956d412404", "avatar": "/assets/c5ed829b4fe97027.webp", "nickname": "181****1341", "isLike": false, "likeCount": 37, "tags": [{"id": 3063, "code": "test", "tagLabel": "王者无界剧场计划", "parentTag": 0, "categoryId": 0, "path": "3063/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1303, "code": "short_animation", "tagLabel": "动画短片", "parentTag": 1300, "categoryId": 0, "path": "1300/1303/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1304, "code": "classic_derivative", "tagLabel": "经典衍生", "parentTag": 1300, "categoryId": 0, "path": "1300/1304/", "tagStatus": 1, "tagOrder": 4, "tagIcon": "", "children": null, "tagType": 1}], "score": 0, "socialMediaUrl": "https://v.douyin.com/LLLjaxwWPCE/", "createAt": "2026年10月03日 20:06", "updateAt": "2026年10月05日 14:19", "publishAt": "2026年10月03日 20:06", "playCount": 679, "viewCreationProcessCount": 181, "copyCanvasCount": 28, "shareCount": 6, "snapshotPath": "/data/canvas-snapshots/67f1d11938ff49c99a58bcf2e5f5dd2d.json.gz", "snapshotSummary": {"nodes": 108, "edges": 141}}, "recommendList": []}