{"detail": {"templateUuid": "b2e4698056c44e2c8ec19c7c6bbf4f38", "projectUuid": "7217166f37c2482183f5b08c4f741a18", "name": "油条两半", "description": "《油条两半》 致我终有遗憾的童年...... 这是一部用我的记忆谱写的影片。我的童年大多是在奶奶家度过的。上星期不知是不是临近清明节的缘故，想起很多小时候的事情。奶奶家在五楼，楼下有骑自行车售卖油条的商家，我们经常用一根麻绳把买的油条吊上来，现在回想仍然有趣至极。马腰这个地方承载了我太多的回忆，大概以后去的机会渺渺，索性做出来。短片的场景还原了70%左右奶奶家的环境。因为一些原因，长大之后去的渐渐少了，奶奶也渐渐老了。我希望用这部影片，让我的童年站住脚步，让我与过去和解，让我的奶奶永远陪在我身边。油条两半，一般喂给了思念，一半留给了遗憾......晚安，奶奶。\nps.影片中的奶奶形象就是本尊，给老太太亲情出演鼓掌👏", "coverUrl": "/assets/cdd20b4445c1aa5d.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/e3babff6d1484ad1aa25b9bcd8e45640/8c0f1ceb891672f38dd99693bd26a4f696926e43.mp4", "snapshotId": 4322, "auditStatus": 1, "ownerId": 2515898, "ownerUuid": "e3babff6d1484ad1aa25b9bcd8e45640", "avatar": "/assets/4edfc4c2dc468209.webp", "nickname": "蒙太神奇", "isLike": false, "likeCount": 1068, "tags": [{"id": 3021, "code": "test", "tagLabel": "AI影像狂飙季", "parentTag": 0, "categoryId": 0, "path": "3021/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3022, "code": "test", "tagLabel": "短片单元", "parentTag": 3021, "categoryId": 0, "path": "3021/3022", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1201, "code": "short_series", "tagLabel": "短片剧集", "parentTag": 1200, "categoryId": 0, "path": "1200/1201/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5003, "name": "荣誉", "icon": "/assets/9b8f94fcb073c296.webp", "primaryIcon": "/assets/deb1579e9091de84.webp", "desc": "LibTV荣誉作者", "verifyLevel": 3}], "score": 0, "socialMediaUrl": "https://v.douyin.com/PSoisQGdW94/", "createAt": "2026年04月11日 13:12", "updateAt": "2026年04月24日 23:26", "publishAt": "2026年04月11日 13:12", "honors": ["短片单元-最佳影片"], "awardedTag": ["短片单元-最佳影片"], "playCount": 325, "viewCreationProcessCount": 125, "copyCanvasCount": 13, "shareCount": 3, "snapshotPath": "/data/canvas-snapshots/b2e4698056c44e2c8ec19c7c6bbf4f38.json.gz", "snapsho