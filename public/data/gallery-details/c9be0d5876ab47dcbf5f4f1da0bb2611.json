{"detail": {"templateUuid": "c9be0d5876ab47dcbf5f4f1da0bb2611", "projectUuid": "af9d1d2bc8304947a0eec21c94551976", "name": "关于《轻》的运动鞋概念片", "description": "一支跑鞋的概念短片尝试，如果“轻”可以是被看见的状态，它会是什么？\n这是一场关于“轻”的视觉实验和艺术想象。整支片子以“轻盈、透气、弹力、原生态”为核心概念，将缓震转译成半透明的凝胶世界，将自然材料想象成正在生长的植物结构。每一次落地，都像水面涟漪被重新点亮；每一次跃起，都像身体短暂脱离重力。\n让科技变轻，让自然有弹性，让脚步从重力里释放。", "coverUrl": "/assets/3d4069a04279bc2e.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/e0f36951510b4b3e82f2f3a8896ee72c/7f467ebcf1d0709a22776a6daff3ee6d29cf3066.mp4", "snapshotId": 11634, "auditStatus": 1, "ownerId": 762715, "ownerUuid": "e0f36951510b4b3e82f2f3a8896ee72c", "avatar": "/assets/893f91376d89ce2f.webp", "nickname": "阿浪Alang", "isLike": false, "likeCount": 279, "tags": [{"id": 1101, "code": "product_show", "tagLabel": "产品展示", "parentTag": 1100, "categoryId": 0, "path": "1100/1101/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1000, "code": "selected", "tagLabel": "精选画布", "parentTag": 0, "categoryId": 0, "path": "1000/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5002, "name": "专业", "icon": "/assets/a31a6cc391430f72.webp", "primaryIcon": "/assets/7097b07d2df12cc8.webp", "desc": "LibTV专业作者", "verifyLevel": 2}], "score": 0, "socialMediaUrl": "http://xhslink.com/o/7AsNwrAFORB", "createAt": "2026年05月16日 20:30", "updateAt": "2026年06月01日 22:44", "publishAt": "2026年05月16日 20:30", "playCount": 94, "viewCreationProcessCount": 41, "copyCanvasCount": 10, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/c9be0d5876ab47dcbf5f4f1da0bb2611.json.gz", "snapshotSummary": {"nodes": 138, "edges": 135}}, "recommendList": []}