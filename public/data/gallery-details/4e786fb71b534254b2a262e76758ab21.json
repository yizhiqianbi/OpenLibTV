{"detail": {"templateUuid": "4e786fb71b534254b2a262e76758ab21", "projectUuid": "0ba33834abf34bfd8feb71dee8bba19b", "name": "《第四十一碗》", "description": "《第四十一碗》聚焦成都老街一家即将拆迁的抄手铺，以“第四十一碗”为情感锚点，讲述老板老陈四十年如一日，每天多包一碗抄手等待已故老友的故事。影片不追求戏剧冲突，而是用 Kodak 胶片质感的长镜头凝视日常：竹片刮过肉馅的沙沙声、黄铜老秤上的铜星、烟盒纸上晕开的字迹。我们试图回答：当城市更新席卷而来，那些没有招牌算法、没有流量密码的烟火小店，凭什么被记住？答案或许就藏在秤称不出来的重量里——那是人与人之间沉默的约定，是市井烟火里最深的在地性。", "coverUrl": "/assets/061d9ad8b9dd94bf.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/a7e2f42e6c3e4593811bb43ddcf333c4/2452b0fcf72daad33a3757a7b334994b8832ae1d.mp4", "snapshotId": 46968, "auditStatus": 1, "ownerId": 6286853, "ownerUuid": "a7e2f42e6c3e4593811bb43ddcf333c4", "avatar": "/assets/61795706d3617908.webp", "nickname": "一帧一帧察细节", "isLike": false, "likeCount": 4, "tags": [{"id": 1201, "code": "short_series", "tagLabel": "短片剧集", "parentTag": 1200, "categoryId": 0, "path": "1200/1201/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1106, "code": "corporate", "tagLabel": "企业宣传", "parentTag": 1100, "categoryId": 0, "path": "1100/1106/", "tagStatus": 1, "tagOrder": 6, "tagIcon": "", "children": null, "tagType": 1}, {"id": 3061, "code": "test", "tagLabel": "4. 无问西东", "parentTag": 3057, "categoryId": 0, "path": "3057/3061", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3057, "code": "test", "tagLabel": "一场戏的诞生 ", "parentTag": 0, "categoryId": 0, "path": "3057/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "socialMediaUrl": "https://www.xiaohongshu.com/discovery/item/6a7888cb000000003400f780?source=webshare&xhsshare=pc_web&xsec_token=ABqf7xPMSPvIIfQukcE_Z4jeZOV9PQxFRb113qLBQjFd4=&xsec_source=pc_share", "skillKeyList": ["character-three-view-expression-sheet-3133844318f040169c77ec81734b