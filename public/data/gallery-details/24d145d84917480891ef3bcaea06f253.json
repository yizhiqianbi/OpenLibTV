{"detail": {"templateUuid": "24d145d84917480891ef3bcaea06f253", "projectUuid": "d0e05789f6094114b448f0b97ec1067c", "name": "六耳猕猴", "description": "2000年，压抑的北漂青年冯年（周鹏饰）在电子城做销售，长期被生活重压裹挟，夜夜失眠，反复梦见自己化作六耳猕猴，身着西装被铁链锁住当众杂耍。工作业绩压力、家人催婚、留城返乡的两难不断折磨他。即便店长即将提拔他，他仍不堪精神内耗梦境现实分不清，荒诞梦境正是都市小人物无处挣脱的精神枷锁隐喻。", "coverUrl": "/assets/01746d5e0ec2ad97.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/db1950cb8e284dd3bc5c1377f0a31f1f/c493ec75f9bc0fc76df95504a2dc17f0c6990321.mp4", "snapshotId": 24636, "auditStatus": 1, "ownerId": 1990068, "ownerUuid": "db1950cb8e284dd3bc5c1377f0a31f1f", "avatar": "http://thirdqq.qlogo.cn/ek_qqapp/AQBsWzmz73iaSciaY0JeialJcVzt2z74dPd3UNSJZzibibiboKm7eticb6libianWdksyOl1WXbAku2hhVXfxibqM84AwL0EwgG6ZmlDiatibFvUcKdS1bu1sr7Poa8/100", "nickname": "泰Q", "isLike": false, "likeCount": 7, "tags": [{"id": 1201, "code": "short_series", "tagLabel": "短片剧集", "parentTag": 1200, "categoryId": 0, "path": "1200/1201/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "createAt": "2026年07月06日 16:04", "updateAt": "2026年07月08日 23:11", "publishAt": "2026年07月06日 16:04", "playCount": 0, "viewCreationProcessCount": 0, "copyCanvasCount": 0, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/24d145d84917480891ef3bcaea06f253.json.gz", "snapshotSummary": {"nodes": 244, "edges": 440}}, "recommendList": []}