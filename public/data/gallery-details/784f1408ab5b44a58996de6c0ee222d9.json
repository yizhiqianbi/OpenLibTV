{"detail": {"templateUuid": "784f1408ab5b44a58996de6c0ee222d9", "projectUuid": "49f5c9d9f0e140da9d32447ee4670903", "name": "东方志怪短片《换骨》", "description": "如果有一座庙，能替人换骨。\n让你青云直上，不复凡身。\n你会进去吗？\n这次尝试做了一支东方志怪气质的 AI 短片。\n灵感来自《聊斋》、民间怪谈，以及一句一直很喜欢的话：\n“人一旦开始厌弃原来的自己，很多东西便回不来了。”\n\n很多时候，我们以为自己是在“变得更好”。\n可或许，只是在一点点换掉原来的骨。", "coverUrl": "/assets/c11d465f278935e2.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/cfd54f65a64c4aa989dd9f7d36a383e0/58886ba8c7f97cb9d8709d2ad505d5dcb0f0a8bd.mp4", "snapshotId": 11244, "auditStatus": 1, "ownerId": 8351234, "ownerUuid": "cfd54f65a64c4aa989dd9f7d36a383e0", "avatar": "/assets/62211e4b8940b5d4.webp", "nickname": "都都沉Doc", "isLike": false, "likeCount": 1122, "tags": [{"id": 3031, "code": "test", "tagLabel": "大乱斗｜vol.1 显形记", "parentTag": 0, "categoryId": 0, "path": "3031/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3033, "code": "test", "tagLabel": "2-剧情与讽刺", "parentTag": 3031, "categoryId": 0, "path": "3031/3033", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1303, "code": "short_animation", "tagLabel": "动画短片", "parentTag": 1300, "categoryId": 0, "path": "1300/1303/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1000, "code": "selected", "tagLabel": "精选画布", "parentTag": 0, "categoryId": 0, "path": "1000/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "score": 0, "socialMediaUrl": "http://xhslink.com/o/AiToqGOZujM", "createAt": "2026年05月15日 01:19", "updateAt": "2026年06月23日 00:03", "publishAt": "2026年05月15日 01:19", "playCount": 499, "viewCreationProcessCount": 136, "copyCanvasCount": 20, "shareCount": 2, "snapshotPath": "/data/canvas-snapshots/784f1408ab5b44a58996de6c0ee222d9.json.gz", "snapshotSummary": {"nodes": 260, "edges": 149}}, "recommendList": []}