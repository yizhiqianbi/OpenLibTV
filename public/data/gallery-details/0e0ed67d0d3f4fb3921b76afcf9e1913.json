{"detail": {"templateUuid": "0e0ed67d0d3f4fb3921b76afcf9e1913", "projectUuid": "cd74ba7b3981462a9eef0fd4ff8b02c0", "name": "《淮水谣》", "description": "淮河之畔，流传着一个关于守护的古老传说。十二位守护者各司其职，守望着人间岁月流转。然而，一场来自深处的异变打破了长久以来的平衡，沉睡的力量逐渐苏醒，天地之间开始出现无法解释的变化。\n面对即将到来的灾难，曾经各自为战的守护者们再次相遇。他们拥有不同的性格，也背负着不同的过去，在冲突与磨合之中，逐渐明白守护的意义。\n当淮水再次翻涌，他们必须做出选择。", "coverUrl": "/assets/06acca316b5b4c87.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/70699fe314204fc19a0a38f11befdcf6/b9dbd389ca4df1fb257d609f4b8f78108374dc4c.mov", "snapshotId": 38930, "auditStatus": 1, "ownerId": 9579959, "ownerUuid": "70699fe314204fc19a0a38f11befdcf6", "avatar": "/assets/165786f84fc38011.webp", "nickname": "薄荷汽油MintGas", "isLike": false, "likeCount": 31, "tags": [{"id": 1303, "code": "short_animation", "tagLabel": "动画短片", "parentTag": 1300, "categoryId": 0, "path": "1300/1303/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}], "score": 0, "createAt": "2026年08月20日 10:57", "updateAt": "2026年08月25日 18:14", "publishAt": "2026年08月20日 10:57", "playCount": 71, "viewCreationProcessCount": 25, "copyCanvasCount": 4, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/0e0ed67d0d3f4fb3921b76afcf9e1913.json.gz", "snapshotSummary": {"nodes": 157, "edges": 266}}, "recommendList": []}