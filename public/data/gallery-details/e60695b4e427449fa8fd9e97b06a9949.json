{"detail": {"templateUuid": "e60695b4e427449fa8fd9e97b06a9949", "projectUuid": "b807972126cb42039328d4ddef59583b", "name": "长河载礼", "description": "以人文纪实视角，溯源中华酒礼文脉。从西周《酒诰》“饮惟祀，德将无醉” 的古训出发，穿越千年，梳理酒作为礼之载体的演变：上古祭祀之仪、周代乡饮酒礼、古代雅集揖让，直至当代餐桌文明。\n影片重在表达：酒的本质不在酣饮，而在分寸与尊重。通过古法酿酒匠心、现代家宴间礼貌拒酒等生活化场景，诠释 “传承不是复刻古俗，而是取其礼，守其德”。以江河远山收束全篇，传递和而不同、理性有度的理念，倡导文明饮酒，让古老礼制在当代生活延续。", "coverUrl": "/assets/4e103110fb6035a5.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/ab5ed3350dce4250b882e45f6fd36fdb/8d5daf5d3a423ab4deb7471236d1c984aa3ff3e4.mp4", "snapshotId": 57579, "auditStatus": 1, "ownerId": 1006483, "ownerUuid": "ab5ed3350dce4250b882e45f6fd36fdb", "avatar": "/assets/b3110bdb88bec0a9.webp", "nickname": "OpenYourEyes", "isLike": false, "likeCount": 0, "tags": [{"id": 1501, "code": "humanity_science", "tagLabel": "人文科普", "parentTag": 1500, "categoryId": 0, "path": "1500/1501/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "socialMediaUrl": "https://weixin.qq.com/sph/AtW0iBDdG", "createAt": "2026年10月09日 11:18", "updateAt": "2026年10月09日 11:35", "publishAt": "2026年10月09日 11:18", "playCount": 27, "viewCreationProcessCount": 3, "copyCanvasCount": 0, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/e60695b4e427449fa8fd9e97b06a9949.json.gz", "snapshotSummary": {"nodes": 55, "edges": 29}}, "recommendList": []}