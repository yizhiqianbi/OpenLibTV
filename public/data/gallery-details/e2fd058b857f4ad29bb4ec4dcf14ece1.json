{"detail": {"templateUuid": "e2fd058b857f4ad29bb4ec4dcf14ece1", "projectUuid": "9182cafed4d344bea09208ab6b80c5e7", "name": "从站位到走位，用导演思维控制Ai视频里的人物调度", "description": "很多人做AI视频的时候，都会遇到同一个问题：\n人物站在哪里不受控制；\n人物往哪里走不受控制；\n多人同框的时候位置关系也经常混乱。\n最后生成出来的画面虽然漂亮，但人物调度完全失控。\n这次我用一组战争片案例，把我平时控制人物站位和运动路线的五种方法完整拆解出来。", "coverUrl": "/assets/37fd37adb47e4182.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/db2f003ebdbf4f919d9f248eaa77ead9/faade78fe84044a15434443d2e7bc50ee18d7110.mp4", "snapshotId": 19921, "auditStatus": 1, "ownerId": 4166157, "ownerUuid": "db2f003ebdbf4f919d9f248eaa77ead9", "avatar": "/assets/3f5ae1ad48a903fd.webp", "nickname": "ShineAi", "isLike": false, "likeCount": 243, "tags": [{"id": 1503, "code": "teaching", "tagLabel": "教学教程", "parentTag": 1500, "categoryId": 0, "path": "1500/1503/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "createAt": "2026年06月16日 22:08", "updateAt": "2026年06月16日 22:18", "publishAt": "2026年06月16日 22:08", "playCount": 105, "viewCreationProcessCount": 39, "copyCanvasCount": 10, "shareCount": 1, "snapshotPath": "/data/canvas-snapshots/e2fd058b857f4ad29bb4ec4dcf14ece1.json.gz", "snapshotSummary": {"nodes": 43, "edges": 46}}, "recommendList": []}