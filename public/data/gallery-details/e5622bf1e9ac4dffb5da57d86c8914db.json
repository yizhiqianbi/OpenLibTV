{"detail": {"templateUuid": "e5622bf1e9ac4dffb5da57d86c8914db", "projectUuid": "e16c2e1af2404be9892280d11bcd57dd", "name": "《显形记》", "description": "随着AI逐渐介入生活、工作、社交与表达，人们开始习惯把选择交给算法，把判断交给答案，把语言交给生成。我们越来越擅长说出得体的话、礼貌的话、成熟的话，却也越来越少真正说出属于自己的话。\n片中的小满，是一个被放大的隐喻。他稚嫩地复述AI给出的“完美答案”，看似荒诞可笑，却恰恰映照出现代成年人早已习以为常的状态：我们在屏幕里寻求最优解，在关系中依赖话术，在情绪里等待模板，人与人之间的交流逐渐变成AI与AI之间的转述。真正的自我、真实的判断和心底的感受，反而被一层层标准答案遮住。\n\n片名《显形记》并不是指某种怪物现身，而是指当标准答案失效之后，当我们不再急着成为别人期待的样子，真实的你，才会慢慢显形。", "coverUrl": "/assets/6f8bbc3bdbd7b3a6.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/e0f36951510b4b3e82f2f3a8896ee72c/5f02357369989cda4fab5d14de10f5b11641dcc8.mp4", "snapshotId": 13315, "auditStatus": 1, "ownerId": 762715, "ownerUuid": "e0f36951510b4b3e82f2f3a8896ee72c", "avatar": "/assets/893f91376d89ce2f.webp", "nickname": "阿浪Alang", "isLike": false, "likeCount": 67, "tags": [{"id": 3031, "code": "test", "tagLabel": "大乱斗｜vol.1 显形记", "parentTag": 0, "categoryId": 0, "path": "3031/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3033, "code": "test", "tagLabel": "2-剧情与讽刺", "parentTag": 3031, "categoryId": 0, "path": "3031/3033", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1303, "code": "short_animation", "tagLabel": "动画短片", "parentTag": 1300, "categoryId": 0, "path": "1300/1303/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1000, "code": "selected", "tagLabel": "精选画布", "parentTag": 0, "categoryId": 0, "path": "1000/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5002, "name": "专业", "icon": "/assets/a31a6cc391430f72.webp", "primaryIcon": "/assets/7097b07d2df12cc8.webp", "desc": "LibTV专业作者", "verifyLevel": 2}], "score": 0, "socialMediaUrl": "http://xhslink.com/o/8oNsaYTXrfx", "createAt": "2026年05月21日 23:28", "updateAt": "2026年06月17日 14:24", "publishAt": "2026年06月17日 14:06", "honors": ["最终入围奖"], "awardedTag": ["最终入围奖"], "pla