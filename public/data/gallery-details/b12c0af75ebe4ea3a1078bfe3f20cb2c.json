{"detail": {"templateUuid": "b12c0af75ebe4ea3a1078bfe3f20cb2c", "projectUuid": "d0caae3eedf447a5a94891b0936671fc", "name": "最后的打卡", "description": "《最后的打卡》是一支融合广府文化与黑色幽默反转的动画短片。外地小蟑螂为寻找父母视频里的广州塔，穿过骑楼街、醒狮训练场、祠堂石狮与凉茶铺，在一路问路中遇见广州的烟火气与非遗风情。它终于抵达塔下打卡，却在跃上拍照点的瞬间被环卫工“啪”地消灭，反转点出“文明广州，从细节开始”", "coverUrl": "/assets/8a23e68f8078e145.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/d54812dfb82a46249c4f6c977ea91c6d/bf89b64ae795eb396c9539195589071186dcfda4.mp4", "snapshotId": 0, "auditStatus": 1, "ownerId": 896477, "ownerUuid": "d54812dfb82a46249c4f6c977ea91c6d", "avatar": "https://thirdwx.qlogo.cn/mmopen/vi_32/r1Mn6UoM8rF2Pr9ibIQydFeOjRkBkiaGqnErX8E3Eibeic2K2HCQH7q3SCKWpRic3PtiaxGLaYAouKiaaUZX5ajqwjDZg/132", "nickname": "ogen.", "isLike": false, "likeCount": 3, "tags": [{"id": 1303, "code": "short_animation", "tagLabel": "动画短片", "parentTag": 1300, "categoryId": 0, "path": "1300/1303/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1205, "code": "culture_tourism", "tagLabel": "文旅政媒", "parentTag": 1200, "categoryId": 0, "path": "1200/1205/", "tagStatus": 1, "tagOrder": 5, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "socialMediaUrl": "https://weixin.qq.com/sph/A6dhvsq3K", "createAt": "2026年07月07日 13:01", "updateAt": "2026年07月07日 19:39", "publishAt": "2026年07月07日 13:01", "playCount": 1, "viewCreationProcessCount": 0, "copyCanvasCount": 0, "shareCount": 0}, "recommendList": []}