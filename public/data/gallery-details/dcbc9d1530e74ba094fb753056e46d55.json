{"detail": {"templateUuid": "dcbc9d1530e74ba094fb753056e46d55", "projectUuid": "b5c53d91496548bfb59ddb29a00dab50", "name": "【透明な境界線】MV", "description": "岩井最残忍也最温柔的一点是\n他从不给青春圆满的结局\n人与人之间隔着一道看不见的透明边界\n离别不需要轰轰烈烈的理由\n或许只是错位的眼神，一阵转瞬即逝的晚风\n就像《透明な境界線》里那张过曝的照片\n拼尽全力想要留住的光，最后只剩模糊透明的轮廓\n握不住的回忆，随风落在车流里\n只剩一句轻声呢喃：再见，我的光\n没有大哭大闹，只有安静的释然与绵长寂寞\n这大概就是独属于岩井俊二的浪漫\n热烈相遇，安静告别，所有遗憾都留在黄昏暮色里", "coverUrl": "/assets/25e56679ba7cdbb0.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/e0a0aacc81744874a57174d9a0431563/69f769675ac5665608887489ba6a783a2e4f4fcf.mp4", "snapshotId": 22665, "auditStatus": 1, "ownerId": 3655864, "ownerUuid": "e0a0aacc81744874a57174d9a0431563", "avatar": "/assets/bf16d6820b53b96f.webp", "nickname": "JIOJIO焦焦", "isLike": false, "likeCount": 812, "tags": [{"id": 1204, "code": "mv", "tagLabel": "MV", "parentTag": 1200, "categoryId": 0, "path": "1200/1204/", "tagStatus": 1, "tagOrder": 4, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1000, "code": "selected", "tagLabel": "精选画布", "parentTag": 0, "categoryId": 0, "path": "1000/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5002, "name": "专业", "icon": "/assets/a31a6cc391430f72.webp", "primaryIcon": "/assets/7097b07d2df12cc8.webp", "desc": "LibTV专业作者", "verifyLevel": 2}], "score": 0, "socialMediaUrl": "https://www.xiaohongshu.com/explore/6a41f57d000000000803d091https://creator.douyin.com/creator-micro/work-management/work-detail/7656674240447434038?enter_from=content?xsec_token=AB2tTAwaySN1efAeiZAudBWcyEi0O8H9emBtkVKnCcaH4=&xsec_source=pc_user", "createAt": "2026年06月29日 13:11", "updateAt": "2026年07月14日 17:51", "publishAt": "2026年06月29日 13:11", "playCount": 960, "viewCreationProcessCount": 417, "copyCanvasCount": 75, "shareCount": 7, "snapshotPath": "/data/canvas-snapshots/dcbc9d1530e74ba094fb753056e46d55.json.gz", "snapshotSummary": {"nodes": 67, "edges": 42}}, "recommendList": []}