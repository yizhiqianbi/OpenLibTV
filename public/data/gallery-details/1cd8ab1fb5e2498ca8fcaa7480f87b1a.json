{"detail": {"templateUuid": "1cd8ab1fb5e2498ca8fcaa7480f87b1a", "projectUuid": "318e32f842aa40969e87062b90f91f47", "name": "贪腐多重宇宙", "description": "本片采用“多重宇宙 / 命运模拟”的高概念设定，探讨党员干部在利益诱惑面前的心理博弈。核心创意聚焦于主角伸向贿赂款的“那一秒钟”，通过脖子处提前预埋的皮下“心弦（Link-Core）”的生物芯片，主角激活瞬间“穿越”到了三个截然不同的平行宇宙，亲身体验了贪欲膨胀后的极端下场，并在三个故事中将“七笔账”具象化，不再是说教，而是用“剥夺感”来警示党员。本片采用AI技术，让画面具有极致冲击力，产生极强的视觉记忆点，剧情上从极致的荒诞回归到家庭的温馨，让警示教育不再是高高在上，而是关乎每个人的“幸福感”。", "coverUrl": "/assets/87c1fb6dbc85bf56.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/46ccf5bc40a44531a81324e276eb7c08/a16b3dbed5ddc16d1f100829a209d1fcefb36522.mp4", "snapshotId": 22312, "auditStatus": 1, "ownerId": 3151914, "ownerUuid": "46ccf5bc40a44531a81324e276eb7c08", "avatar": "/assets/32da55e3c8a8bc82.webp", "nickname": "长颈鹿AIGC_队长", "isLike": false, "likeCount": 14, "tags": [{"id": 1201, "code": "short_series", "tagLabel": "短片剧集", "parentTag": 1200, "categoryId": 0, "path": "1200/1201/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1000, "code": "selected", "tagLabel": "精选画布", "parentTag": 0, "categoryId": 0, "path": "1000/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1108, "code": "public_welfare", "tagLabel": "公益广告", "parentTag": 1100, "categoryId": 0, "path": "1100/1108/", "tagStatus": 1, "tagOrder": 8, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "createAt": "2026年06月27日 15:07", "updateAt": "2026年06月27日 17:59", "publishAt": "2026年06月27日 15:07", "playCount": 7, "viewCreationProcessCount": 2, "copyCanvasCount": 1, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/1cd8ab1fb5e2498ca8fcaa7480f87b1a.json.gz", "snapshotSummary": {"nodes": 661, "edges": 417}}, "recommendList": []}