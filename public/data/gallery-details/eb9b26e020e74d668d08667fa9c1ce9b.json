{"detail": {"templateUuid": "eb9b26e020e74d668d08667fa9c1ce9b", "projectUuid": "eab051bb7b2846dc998dc0ae6480be88", "name": "AI短片《黄色墙纸》", "description": "她被丈夫带到乡间别墅“疗养”。\n不许工作，不许写字，不许胡思乱想。\n她唯一能凝视的，只剩下房间里那面肮脏的黄色墙纸。\n白天，它只是墙纸。\n夜晚，它开始像某种活物一样缓慢蠕动。\n她看见一个女人。\n然后，是无数个女人。\n\n改编自夏洛特·珀金斯·吉尔曼的同名经典小说。\n这不是一个单纯关于“疯癫”的故事，而是关于压抑、控制、失语，以及一个女人如何在沉默中被吞噬。", "coverUrl": "/assets/5e536875455e6459.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/ee3b29b96c1c49e4aff481ffd68c28f7/cc5cbd60f8ed80e61d61ba4a4f375bd2dba69c2a.mp4", "snapshotId": 5067, "auditStatus": 1, "ownerId": 5070332, "ownerUuid": "ee3b29b96c1c49e4aff481ffd68c28f7", "avatar": "/assets/b81a523dca98e37d.webp", "nickname": "墨墨墨Ink", "isLike": false, "likeCount": 27, "tags": [{"id": 3021, "code": "test", "tagLabel": "AI影像狂飙季", "parentTag": 0, "categoryId": 0, "path": "3021/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3022, "code": "test", "tagLabel": "短片单元", "parentTag": 3021, "categoryId": 0, "path": "3021/3022", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1303, "code": "short_animation", "tagLabel": "动画短片", "parentTag": 1300, "categoryId": 0, "path": "1300/1303/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5002, "name": "专业", "icon": "/assets/a31a6cc391430f72.webp", "primaryIcon": "/assets/7097b07d2df12cc8.webp", "desc": "LibTV专业作者", "verifyLevel": 2}], "score": 0, "socialMediaUrl": "https://www.xiaohongshu.com/explore/69de5c3d000000002102d095?xsec_token=ABM-XM_7zlcdNIHTrsQU1JP_yFJLUxrreYoiy4VsjdzJg=&xsec_source=pc_user", "createAt": "2026年04月15日 00:09", "updateAt": "2026年04月23日 23:11", "publishAt": "2026年04月15日 00:09", "honors": ["短片单元-入围"], "awardedTag": ["短片单元-入围"], "playCount": 10, "viewCreationProcessCount": 1, "copyCanvasCount": 0, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/eb9b26e020e74d668d08667fa9c1ce9b.json.gz", "snapshotSummary": {"nodes"