{"detail": {"templateUuid": "a5b928b9dd9d440c81678ed7d319395e", "projectUuid": "dae8db1d4cf84676963fce00b097efa9", "name": "《最后一针》", "description": "这幅画，是外婆一生的偏爱，像心里反复温习的春天，从未凋谢。一朵石榴花，在许多人低头的沉默里长出来。那时我才知道，外婆守着的，从来不只是一幅画。是那些一起接过线的人，一起染过色的人，一起把花和籽缝在一处的人。最后一针落下时，像很久以前有许多双手，又回到了同一朵花里。一针一线，石榴花开，同心同向，生生不息！", "coverUrl": "/assets/115a70cbc4311bc0.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/3e41c8ec7c4b40b5b8e1d1807c08fe8c/66e5511744e75e06ff963b2987e77ff90b695ad6.mp4", "snapshotId": 25289, "auditStatus": 1, "ownerId": 9015771, "ownerUuid": "3e41c8ec7c4b40b5b8e1d1807c08fe8c", "avatar": "/assets/1e006c8ebc194d10.webp", "nickname": "胖马PangMa", "isLike": false, "likeCount": 27, "tags": [{"id": 3040, "code": "test", "tagLabel": "广告导演请就位", "parentTag": 0, "categoryId": 0, "path": "3040/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3043, "code": "test", "tagLabel": "3-非遗创生", "parentTag": 3040, "categoryId": 0, "path": "3040/3043", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1201, "code": "short_series", "tagLabel": "短片剧集", "parentTag": 1200, "categoryId": 0, "path": "1200/1201/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1501, "code": "humanity_science", "tagLabel": "人文科普", "parentTag": 1500, "categoryId": 0, "path": "1500/1501/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "socialMediaUrl": "https://v.douyin.com/HNJXFDqpgqU/", "createAt": "2026年07月08日 17:11", "updateAt": "2026年07月08日 21:10", "publishAt": "2026年07月08日 17:30", "playCount": 14, "viewCreationProcessCount": 4, "copyCanvasCount": 0, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/a5b928b9dd9d440c81678ed7d319395e.json.gz", "snapshotSummary": {"