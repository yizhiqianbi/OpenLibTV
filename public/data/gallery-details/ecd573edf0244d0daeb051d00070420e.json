{"detail": {"templateUuid": "ecd573edf0244d0daeb051d00070420e", "projectUuid": "9e78219ba92f490986139d26fa4ef9c7", "name": "不周山之变", "description": "西北大荒有山，名曰不周。其峰上抵天穹，山根深系大地，世人皆以为日月循行、江河有向，皆因这座天柱仍立于天地之间。山中设有衡天台与地维渠，守衡者终年观星、听石、测水，只为察觉天地最细微的偏移。", "coverUrl": "/assets/83bd0ac0bc969cd9.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/e1a8d149cb6c445b91a5f4926f0a0483/9f941d13857aa8a097c5c85ea8d61272070275ee.mp4", "snapshotId": 39165, "auditStatus": 1, "ownerId": 3238672, "ownerUuid": "e1a8d149cb6c445b91a5f4926f0a0483", "avatar": "/assets/1a49902a29e8acd3.webp", "nickname": "Rick", "isLike": false, "likeCount": 73, "tags": [{"id": 1202, "code": "style_aesthetic", "tagLabel": "风格美学", "parentTag": 1200, "categoryId": 0, "path": "1200/1202/", "tagStatus": 1, "tagOrder": 2, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5002, "name": "专业", "icon": "/assets/a31a6cc391430f72.webp", "primaryIcon": "/assets/7097b07d2df12cc8.webp", "desc": "LibTV专业作者", "verifyLevel": 2}], "score": 0, "socialMediaUrl": "https://www.xiaohongshu.com/explore/6a7b482f000000002403f62e?xsec_token=ABHHIfPNEey1SaSBgTv8vyYvgsbBw5yCYQiXK1yND519g=&xsec_source=pc_user", "createAt": "2026年08月20日 20:01", "updateAt": "2026年08月20日 20:11", "publishAt": "2026年08月20日 20:01", "playCount": 660, "viewCreationProcessCount": 220, "copyCanvasCount": 42, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/ecd573edf0244d0daeb051d00070420e.json.gz", "snapshotSummary": {"nodes": 60, "edges": 31}}, "recommendList": []}