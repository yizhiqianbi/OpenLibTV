{"detail": {"templateUuid": "82f61046c38f430cb25b9aefd73eddc4", "projectUuid": "8b77384d8dba4a28af46afa139b088f3", "name": "奔跑治愈一切", "description": "成年以后，我们好像一直都在赶路。\n赶地铁、赶会议、赶项目、赶时间。\n总觉得再快一点，\n就能追上什么。\n马拉松从来不只是42.195公里。\n它更像一次提醒。\n提醒我们：\n生活不是一场必须赢过别人的比赛。\n可以认真工作，\n也可以享受生活。\n可以奋力向前，\n也别忘了感受风吹过脸颊的快乐。", "coverUrl": "/assets/0ee77f792f5b716f.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/efb780f73c564dfcb90f2bb67cc1702d/16a86347c31b5c40f169c4e1e788230fd9398b6a.mp4", "snapshotId": 20127, "auditStatus": 1, "ownerId": 9541664, "ownerUuid": "efb780f73c564dfcb90f2bb67cc1702d", "avatar": "/assets/b30fc92829cecff7.webp", "nickname": "Rec7700", "isLike": false, "likeCount": 5, "tags": [{"id": 1106, "code": "corporate", "tagLabel": "企业宣传", "parentTag": 1100, "categoryId": 0, "path": "1100/1106/", "tagStatus": 1, "tagOrder": 6, "tagIcon": "", "children": null, "tagType": 1}, {"id": 3040, "code": "test", "tagLabel": "广告导演请就位", "parentTag": 0, "categoryId": 0, "path": "3040/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3042, "code": "test", "tagLabel": "2-故事短片", "parentTag": 3040, "categoryId": 0, "path": "3040/3042", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}], "score": 0, "socialMediaUrl": "31 【跑步治愈一切  - Rec.777 | 小红书 - 你的生活兴趣社区】 😆 yUK1kT6Wj4gZhGI 😆 https://www.xiaohongshu.com/discovery/item/6a292f7c00000000170081dd?source=webshare&xhsshare=pc_web&xsec_token=ABW0x3fgCVH4LOcJ10XQHz9R9U_0KlQ-o4fNs-CntN1u4=&xsec_source=pc_share", "createAt": "2026年06月16日 08:49", "updateAt": "2026年06月17日 15:21", "publishAt": "2026年06月17日 15:11", "honors": ["故事短片-提名奖"], "awardedTag": ["故事短片-提名奖"], "playCount": 24, "viewCreationProcessCount": 3, "copyCanvasCount": 1, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/82f61046c38f430cb25b9aefd73eddc4.json.gz", "snapshotSummary": {"nodes": 103, "edges": 91}}, "recommendList": []}