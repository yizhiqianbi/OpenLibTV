{"detail": {"templateUuid": "1aeebf566de743828c89c0ccc024f3e5", "projectUuid": "0edf06f3940741bd95beb103586b2b90", "name": "人虫虽异，命数相同。今日执笼，明日入笼...", "description": "本片名为《入笼》，借《聊斋志异·促织》的故事骨架，对古典文学进行当代表达，重构一段关于欲望、因果与人性的东方寓言。现实与幻境彼此交叠，人与虫、生与死的边界逐渐模糊。笼中究竟关着什么？是虫，是鱼，是孩子，还是成名？从笼中之人，到执笼之人，再到笼中之物，因果亦在轮回之间完成闭合。主角仿佛始终处在六道轮回之内。人总觉得能逃出命运，却浑然不知，所谓出口，不过是另一只笼子的入口......", "coverUrl": "/assets/a02a7dde1e18f7cd.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/e3babff6d1484ad1aa25b9bcd8e45640/c1af2abed07bcec336c5cedfda6a2e69bef94a11.mp4", "snapshotId": 37649, "auditStatus": 1, "ownerId": 2515898, "ownerUuid": "e3babff6d1484ad1aa25b9bcd8e45640", "avatar": "/assets/4edfc4c2dc468209.webp", "nickname": "蒙太神奇", "isLike": false, "likeCount": 16, "tags": [{"id": 1303, "code": "short_animation", "tagLabel": "动画短片", "parentTag": 1300, "categoryId": 0, "path": "1300/1303/", "tagStatus": 1, "tagOrder": 3, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1000, "code": "selected", "tagLabel": "精选画布", "parentTag": 0, "categoryId": 0, "path": "1000/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5003, "name": "荣誉", "icon": "/assets/9b8f94fcb073c296.webp", "primaryIcon": "/assets/deb1579e9091de84.webp", "desc": "LibTV荣誉作者", "verifyLevel": 3}], "score": 0, "skillKeyList": ["aesthetic-tone-consistency-020b92eb952140af9a99e594358a115b"], "sessionSnapshots": [{"sessionId": "e4b89c14-6323-401d-bcbd-630794cb6cae", "name": "聊斋志怪动画", "createdAtMs": 1786332308158, "shareId": "5Z5OOvnrxs", "lastMessageId": "1009182280822939652"}], "skillTemplateList": [{"skillKey": "aesthetic-tone-consistency-020b92eb952140af9a99e594358a115b", "name": "美学统一调性短片", "templateUuid": "f14bd9181d6f47a7befe15fa57ceba7c"}], "shareIds": ["5Z5OOvnrxs"], "createAt": "2026年08月16日 14:50", "updateAt": "2026年08月17日 11:31", "publishAt": "2026年08月17日 10:59", "playCount": 58, "viewCreationProcessCount": 21, "copyCanvasCount": 4, "shareCount": 0, "snapshotPath": "/d