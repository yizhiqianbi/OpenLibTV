{"detail": {"templateUuid": "db4a71a4d2764c5ebbcc65e21eca859f", "projectUuid": "6cf4496b43aa4dc684b21964809ccdce", "name": "高德扫街榜｜纪实短片《赊店一口》", "description": "在河南赊店老街，老王守着一方灶台，一干就是二十多年。\n酥到掉渣的火烧，裹上软烂入味的卤肉，最后浇一勺滚烫的老汤。\n他说，做这行没啥秘诀，就是不能糊弄。\n差一分火候不给肉，少一样大料不下锅。\n这支短片，记录下了赊店古镇最真实的温度。别管外面咋变，这里的味道，永远是这个样儿。", "coverUrl": "/assets/e235bcb8ad931cec.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/4c68f71a8ace435b99086ffa87cdca43/68604cc85b81a9fe0c58ccdc0a4757c98c04253f.mp4", "snapshotId": 33859, "auditStatus": 1, "ownerId": 5083534, "ownerUuid": "4c68f71a8ace435b99086ffa87cdca43", "avatar": "/assets/1c84c4f8c8b55857.webp", "nickname": "BoliSuna", "isLike": false, "likeCount": 27, "tags": [{"id": 3045, "code": "test", "tagLabel": "走，我们扫街去", "parentTag": 0, "categoryId": 0, "path": "3045/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3046, "code": "test", "tagLabel": "1-人间烟火", "parentTag": 3045, "categoryId": 0, "path": "3045/3046", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1104, "code": "creative_tvc", "tagLabel": "创意TVC", "parentTag": 1100, "categoryId": 0, "path": "1100/1104/", "tagStatus": 1, "tagOrder": 4, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1206, "code": "documentary", "tagLabel": "纪实·访谈", "parentTag": 1200, "categoryId": 0, "path": "1200/1206/", "tagStatus": 1, "tagOrder": 6, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "socialMediaUrl": "https://www.douyin.com/user/self?from_tab_name=main&modal_id=7670386492207942921&showTab=post", "createAt": "2026年08月06日 10:58", "updateAt": "2026年09月24日 20:45", "publishAt": "2026年08月06日 10:59", "honors": ["街角温度"], "awardedTag": ["街角温度"], "playCount": 58, "viewCreationProcessCount": 25, "copyCanvasCount": 5, "shareCount": 2, "sna