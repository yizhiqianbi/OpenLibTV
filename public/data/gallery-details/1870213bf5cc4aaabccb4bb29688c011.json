{"detail": {"templateUuid": "1870213bf5cc4aaabccb4bb29688c011", "projectUuid": "f8e59177964347b2b49750be75673c66", "name": "一张地图，八朝烟火", "description": "一位宋朝行者在汴京长街的雨夜独饮，一碗酒落，斗转星移。当他再次睁开眼，却撞进了开封鼓楼夜市绚烂的现代霓虹与灯海中。面对满街目眩神迷的美食，迷失无助的他，遇到了几个身着汉服、拿着手机“扫街”的现代年轻人……\n“从古至今，城换了，人换了，但只要循着这张图，最抚凡人心的烟火，就永远都在。”", "coverUrl": "/assets/694105455f5f777f.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/d20421bb9cac40fb99763d309111430a/f874418d9fccc0a814838db25c397b685f704fc9.mp4", "snapshotId": 37217, "auditStatus": 1, "ownerId": 3462983, "ownerUuid": "d20421bb9cac40fb99763d309111430a", "avatar": "/assets/60489f75b1a0bf42.webp", "nickname": "大大大大大", "isLike": false, "likeCount": 2, "tags": [{"id": 3045, "code": "test", "tagLabel": "走，我们扫街去", "parentTag": 0, "categoryId": 0, "path": "3045/", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 3047, "code": "test", "tagLabel": "2-城市状元", "parentTag": 3045, "categoryId": 0, "path": "3045/3047", "tagStatus": 1, "tagOrder": 10, "tagIcon": "", "children": null, "tagType": 5}, {"id": 1205, "code": "culture_tourism", "tagLabel": "文旅政媒", "parentTag": 1200, "categoryId": 0, "path": "1200/1205/", "tagStatus": 1, "tagOrder": 5, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1104, "code": "creative_tvc", "tagLabel": "创意TVC", "parentTag": 1100, "categoryId": 0, "path": "1100/1104/", "tagStatus": 1, "tagOrder": 4, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1106, "code": "corporate", "tagLabel": "企业宣传", "parentTag": 1100, "categoryId": 0, "path": "1100/1106/", "tagStatus": 1, "tagOrder": 6, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1000, "code": "selected", "tagLabel": "精选画布", "parentTag": 0, "categoryId": 0, "path": "1000/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5002, "name": "专业", "icon": "/assets/a31a6cc391430f72.webp", "primaryIcon": "/assets/7097b07d2df12cc8.webp", "desc": "LibTV专业作者", "verifyLevel": 