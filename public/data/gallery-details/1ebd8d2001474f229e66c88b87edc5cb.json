{"detail": {"templateUuid": "1ebd8d2001474f229e66c88b87edc5cb", "projectUuid": "c062fc4d05a74a19a636007e989ba593", "name": "琥珀色甜品梦境", "description": "女孩在厨房桌面午睡，梦见自己坠入一个糖做的世界。蛋糕浮岛悬在奶油云海上，焦糖溪流缓缓流淌。她坐旋转马卡龙穿梭甜点群岛，爬上巨大的熊仔蛋糕顶层，向远方招手。糖珠摩天轮、布丁蹦床、甘草糖桥……每样甜品都藏着微小的奇迹。梦醒后，手里还握着那颗琥珀色糖珠。有些甜，只属于梦境——但手心的温度，是真的。", "coverUrl": "/assets/7b2806e57c0388ab.webp", "finalOutput": "https://libtv-res.liblib.art/upload-images/e5c05143074646b7ae70a88b81ec6c2a/11f79071938db7d2daa314867e6aa53a00855238.MP4", "snapshotId": 25047, "auditStatus": 1, "ownerId": 773892, "ownerUuid": "e5c05143074646b7ae70a88b81ec6c2a", "avatar": "/assets/f42d9e46705dc874.webp", "nickname": "星美Fine", "isLike": false, "likeCount": 8, "tags": [{"id": 1201, "code": "short_series", "tagLabel": "短片剧集", "parentTag": 1200, "categoryId": 0, "path": "1200/1201/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}, {"id": 1000, "code": "selected", "tagLabel": "精选画布", "parentTag": 0, "categoryId": 0, "path": "1000/", "tagStatus": 1, "tagOrder": 1, "tagIcon": "", "children": null, "tagType": 1}], "userTags": [{"tagId": 5001, "name": "先锋", "icon": "/assets/15bcb4d002b68470.webp", "primaryIcon": "/assets/b40570481582e92f.webp", "desc": "LibTV先锋作者", "verifyLevel": 1}], "score": 0, "socialMediaUrl": "抖音:https://v.douyin.com/kkK6gUVtb7A/ B站：https://www.bilibili.com/video/BV14zMh6xEDM/?spm_id_from=333.1387.homepage.video_card.click 小红书：https://www.xiaohongshu.com/explore/6a4d1474000000001101b58a?xsec_token=ABcl0dLx4-mm6Y5g3ugetZAlq-IdVbmKkHyzxJwyGtJIc=&xsec_source=pc_user", "createAt": "2026年07月07日 23:32", "updateAt": "2026年07月07日 23:42", "publishAt": "2026年07月07日 23:32", "playCount": 3, "viewCreationProcessCount": 0, "copyCanvasCount": 0, "shareCount": 0, "snapshotPath": "/data/canvas-snapshots/1ebd8d2001474f229e66c88b87edc5cb.json.gz", "snapshotSummary": {"nodes": 42, "edges": 130}}, "recommendList": []}